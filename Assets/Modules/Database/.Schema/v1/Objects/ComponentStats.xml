    <member name="AlterWeaponPlatform" type="int" options="obsolete"/>
    <member name="AutoAimingArc" type="float" minvalue="0" maxvalue="360"/>
    <member name="TurretTurnSpeed" type="float" minvalue="-1000" maxvalue="1000" />

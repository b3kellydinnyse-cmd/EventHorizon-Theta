    <member name="WeaponRangeModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="WeaponEnergyCostModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="WeaponVelocityModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="WeaponAoeModifier" type="float" minvalue="-100" maxvalue="100" />

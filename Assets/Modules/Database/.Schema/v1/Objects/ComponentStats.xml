<?xml version="1.0" encoding="UTF-8"?>
<data name="ComponentStats" type="object" typeid="ComponentStats" >
    <!-- Base category -->
    <member name="Type" type="enum" typeid="ComponentStatsType" />

    <!-- Armor and repair -->
    <member name="ArmorPoints" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="ArmorRepairRate" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="ArmorRepairCooldownModifier" type="float" minvalue="-1" maxvalue="1" />

    <!-- Energy and recharge -->
    <member name="EnergyPoints" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="EnergyRechargeRate" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="EnergyRechargeCooldownModifier" type="float" minvalue="-5" maxvalue="5" />
    
    <!-- Shield and recharge -->
    <member name="ShieldPoints" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="ShieldRechargeRate" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="ShieldRechargeCooldownModifier" type="float" minvalue="-5" maxvalue="5" />

    <!-- Mass and inertia -->
    <member name="Weight" type="float" minvalue="-1000000" maxvalue="1000000" />

    <!-- Collision, ramming and energy absorption -->
    <member name="RammingDamage" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="RammingDamageModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="EnergyAbsorption" type="float" minvalue="-1000000" maxvalue="1000000" />

    <!-- Damage resistances -->
    <member name="KineticResistance" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="EnergyResistance" type="float" minvalue="-1000000" maxvalue="1000000" />
    <member name="ThermalResistance" type="float" minvalue="-1000000" maxvalue="1000000" />

    <!-- Engine propulsion, agility and boosters -->
    <member name="EnginePower" type="float" minvalue="-2000" maxvalue="2000" />
    <member name="TurnRate" type="float" minvalue="-2000" maxvalue="2000" />
    <member name="EnginePowerModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="TurnRateModifier" type="float" minvalue="-100" maxvalue="100" />

    <!-- Autopilot -->
    <member name="Autopilot" type="bool" />

    <!-- Drone bay stats and modifiers -->
    <member name="DroneRangeModifier" type="float" minvalue="-50" maxvalue="50" />
    <member name="DroneDamageModifier" type="float" minvalue="-50" maxvalue="50" />
    <member name="DroneDefenseModifier" type="float" minvalue="-50" maxvalue="50" />

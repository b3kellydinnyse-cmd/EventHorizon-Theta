    <member name="DeviceCooldownModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="DevicePowerModifier" type="float" minvalue="-100" maxvalue="100" />
    <member name="DeviceRangeModifier" type="float" minvalue="-100" maxvalue="100" />

